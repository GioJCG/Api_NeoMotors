generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDIENTE
  ACTIVO
  INACTIVO
  BLOQUEADO
}

model Usuario {
  id           String     @id @default(uuid()) @map("id")
  email        String     @unique @map("email")
  passwordHash String?    @map("password_hash")
  nombre       String?    @map("nombre")
  estado       UserStatus @default(PENDIENTE) @map("estado")

  intentosFallidos Int      @default(0) @map("intentos_fallidos")
  bloqueadoHasta   DateTime? @map("bloqueado_hasta")

  companyId String? @map("company_id")
  branchId  String? @map("branch_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  verificaciones      VerificacionCuenta[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  proveedoresSociales ProveedorSocial[]
  empresa             Empresa?      @relation(fields: [companyId], references: [id])
  roles               UsuarioRol[]

  @@map("Usuario")
}

model VerificacionCuenta {
  id        String   @id @default(uuid()) @map("id")
  usuarioId String   @map("usuario_id")
  token     String   @unique @map("token")
  expiraEn  DateTime @map("expira_en")
  usado     Boolean  @default(false) @map("usado")

  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("VerificacionCuenta")
}

model RefreshToken {
  id        String   @id @default(uuid()) @map("id")
  usuarioId String   @map("usuario_id")
  token     String   @unique @map("token")
  expiraEn  DateTime @map("expira_en")
  usado     Boolean  @default(false) @map("usado")
  revocado  Boolean  @default(false) @map("revocado")

  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("RefreshToken")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @map("id")
  usuarioId String   @map("usuario_id")
  token     String   @unique @map("token")
  expiraEn  DateTime @map("expira_en")
  usado     Boolean  @default(false) @map("usado")

  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("PasswordResetToken")
}

model ProveedorSocial {
  id         String   @id @default(uuid()) @map("id")
  usuarioId  String   @map("usuario_id")
  provider   String   @map("provider")
  providerId String   @map("provider_id")

  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("ProveedorSocial")
}

model Rol {
  id          String   @id @default(uuid()) @map("id")
  nombre      String   @unique @map("nombre")
  descripcion String?  @map("descripcion")
  esGlobal    Boolean  @default(true) @map("es_global")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  usuarios  UsuarioRol[]
  permisos  RolPermiso[]

  @@map("Rol")
}

model Permiso {
  id          String   @id @default(uuid()) @map("id")
  nombre      String   @unique @map("nombre")
  descripcion String?  @map("descripcion")
  modulo      String   @map("modulo")
  accion      String   @map("accion")

  createdAt DateTime @default(now()) @map("created_at")

  roles RolPermiso[]

  @@map("Permiso")
}

model RolPermiso {
  rolId     String @map("rol_id")
  permisoId String @map("permiso_id")

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@map("RolPermiso")
}

model UsuarioRol {
  id        String  @id @default(uuid()) @map("id")
  usuarioId String  @map("usuario_id")
  rolId     String  @map("rol_id")
  companyId String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, rolId, companyId])
  @@map("UsuarioRol")
}

enum EmpresaStatus {
  ACTIVA
  SUSPENDIDA
  INACTIVA
}

model Empresa {
  id                 String        @id @default(uuid()) @map("id")
  nombre             String        @map("nombre")
  rfc                String        @unique @map("rfc")
  razonSocial        String        @map("razon_social")
  codigoPostalFiscal String        @map("codigo_postal_fiscal")
  regimenFiscal      String        @map("regimen_fiscal")
  logoUrl            String?       @map("logo_url")
  colorPrimario      String?       @map("color_primario")
  colorSecundario    String?       @map("color_secundario")
  tema               String?       @default("light") @map("tema")
  estado             EmpresaStatus @default(ACTIVA) @map("estado")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  usuarios   Usuario[]
  sucursales Sucursal[]

  @@map("Empresa")
}

model Sucursal {
  id         String  @id @default(uuid()) @map("id")
  empresaId  String  @map("empresa_id")
  nombre     String  @map("nombre")
  direccion  String? @map("direccion")
  telefono   String? @map("telefono")
  esMatriz   Boolean @default(false) @map("es_matriz")
  latitud    Float?  @map("latitud")
  longitud   Float?  @map("longitud")
  estado     String  @default("ACTIVA") @map("estado")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@map("Sucursal")
}

model Auditoria {
  id        String   @id @default(uuid()) @map("id")
  usuarioId String?  @map("usuario_id")
  accion    String   @map("accion")
  entidad   String   @map("entidad")
  entidadId String?  @map("entidad_id")
  payload   Json?    @map("payload")
  contexto  String?  @map("contexto")
  ip        String?  @map("ip")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("Auditoria")
}
