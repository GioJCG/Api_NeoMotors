generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDIENTE
  ACTIVO
  INACTIVO
  BLOQUEADO
}

model Usuario {
  id           String     @id @default(uuid()) @map("id")
  email        String     @unique @map("email")
  passwordHash String?    @map("password_hash")
  nombre       String?    @map("nombre")
  estado       UserStatus @default(PENDIENTE) @map("estado")

  intentosFallidos Int       @default(0) @map("intentos_fallidos")
  bloqueadoHasta   DateTime? @map("bloqueado_hasta")

  companyId String? @map("company_id")
  branchId  String? @map("branch_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  verificaciones      VerificacionCuenta[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  proveedoresSociales ProveedorSocial[]
  empresa             Empresa?             @relation(fields: [companyId], references: [id])
  roles               UsuarioRol[]
  empresasAsignadas   UsuarioEmpresa[]
  sucursalesAsignadas UsuarioSucursal[]

  @@map("Usuario")
}

model VerificacionCuenta {
  id        String   @id @default(uuid()) @map("id")
  usuarioId String   @map("usuario_id")
  token     String   @unique @map("token")
  expiraEn  DateTime @map("expira_en")
  usado     Boolean  @default(false) @map("usado")

  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("VerificacionCuenta")
}

model RefreshToken {
  id        String   @id @default(uuid()) @map("id")
  usuarioId String   @map("usuario_id")
  token     String   @unique @map("token")
  expiraEn  DateTime @map("expira_en")
  usado     Boolean  @default(false) @map("usado")
  revocado  Boolean  @default(false) @map("revocado")

  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("RefreshToken")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @map("id")
  usuarioId String   @map("usuario_id")
  token     String   @unique @map("token")
  expiraEn  DateTime @map("expira_en")
  usado     Boolean  @default(false) @map("usado")

  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("PasswordResetToken")
}

model ProveedorSocial {
  id         String @id @default(uuid()) @map("id")
  usuarioId  String @map("usuario_id")
  provider   String @map("provider")
  providerId String @map("provider_id")

  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("ProveedorSocial")
}

model Rol {
  id          String  @id @default(uuid()) @map("id")
  nombre      String  @unique @map("nombre")
  descripcion String? @map("descripcion")
  esGlobal    Boolean @default(true) @map("es_global")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  usuarios UsuarioRol[]
  permisos RolPermiso[]

  @@map("Rol")
}

model Permiso {
  id          String  @id @default(uuid()) @map("id")
  nombre      String  @unique @map("nombre")
  descripcion String? @map("descripcion")
  modulo      String  @map("modulo")
  accion      String  @map("accion")

  createdAt DateTime @default(now()) @map("created_at")

  roles RolPermiso[]

  @@map("Permiso")
}

model RolPermiso {
  rolId     String @map("rol_id")
  permisoId String @map("permiso_id")

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@map("RolPermiso")
}

model UsuarioRol {
  id        String  @id @default(uuid()) @map("id")
  usuarioId String  @map("usuario_id")
  rolId     String  @map("rol_id")
  companyId String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, rolId, companyId])
  @@map("UsuarioRol")
}

enum EmpresaStatus {
  ACTIVA
  SUSPENDIDA
  INACTIVA
}

model Empresa {
  id                 String        @id @default(uuid()) @map("id")
  nombre             String        @map("nombre")
  rfc                String        @unique @map("rfc")
  razonSocial        String        @map("razon_social")
  codigoPostalFiscal String        @map("codigo_postal_fiscal")
  regimenFiscal      String        @map("regimen_fiscal")
  logoUrl            String?       @map("logo_url")
  colorPrimario      String?       @map("color_primario")
  colorSecundario    String?       @map("color_secundario")
  tema               String?       @default("light") @map("tema")
  estado             EmpresaStatus @default(ACTIVA) @map("estado")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  usuarios        Usuario[]
  sucursales      Sucursal[]
  usuariosAsignados UsuarioEmpresa[]
  clientes        Cliente[]
  vehiculos       Vehiculo[]

  @@map("Empresa")
}

model Sucursal {
  id        String  @id @default(uuid()) @map("id")
  empresaId String  @map("empresa_id")
  nombre    String  @map("nombre")
  direccion String? @map("direccion")
  telefono  String? @map("telefono")
  esMatriz  Boolean @default(false) @map("es_matriz")
  latitud   Float?  @map("latitud")
  longitud  Float?  @map("longitud")
  estado    String  @default("ACTIVA") @map("estado")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  empresa           Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuariosAsignados UsuarioSucursal[]

  @@map("Sucursal")
}

model UsuarioEmpresa {
  id        String  @id @default(uuid()) @map("id")
  usuarioId String  @map("usuario_id")
  empresaId String  @map("empresa_id")
  activa    Boolean @default(false) @map("activa")

  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, empresaId])
  @@map("UsuarioEmpresa")
}

model UsuarioSucursal {
  id         String  @id @default(uuid()) @map("id")
  usuarioId  String  @map("usuario_id")
  sucursalId String  @map("sucursal_id")
  activa     Boolean @default(false) @map("activa")

  createdAt DateTime @default(now()) @map("created_at")

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sucursal Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, sucursalId])
  @@map("UsuarioSucursal")
}

model Auditoria {
  id        String  @id @default(uuid()) @map("id")
  usuarioId String? @map("usuario_id")
  accion    String  @map("accion")
  entidad   String  @map("entidad")
  entidadId String? @map("entidad_id")
  payload   Json?   @map("payload")
  contexto  String? @map("contexto")
  ip        String? @map("ip")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("Auditoria")
}

model Marca {
  id        String   @id @default(uuid()) @map("id")
  nombre    String   @unique @map("nombre")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  modelos  Modelo[]
  vehiculos Vehiculo[]

  @@map("Marca")
}

model Modelo {
  id      String @id @default(uuid()) @map("id")
  marcaId String @map("marca_id")
  nombre  String @map("nombre")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String? @map("created_by")

  marca   Marca     @relation(fields: [marcaId], references: [id], onDelete: Cascade)
  vehiculos Vehiculo[]

  @@unique([marcaId, nombre])
  @@map("Modelo")
}

model Vehiculo {
  id         String   @id @default(uuid()) @map("id")
  empresaId  String   @map("empresa_id")
  clienteId  String   @map("cliente_id")
  marcaId    String   @map("marca_id")
  modeloId   String   @map("modelo_id")
  placa      String   @map("placa")
  numeroSerie String? @map("numero_serie")
  anio       Int?     @map("anio")
  color      String?  @map("color")
  estado     String   @default("ACTIVO") @map("estado")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cliente Cliente @relation(fields: [clienteId], references: [id])
  marca   Marca   @relation(fields: [marcaId], references: [id])
  modelo  Modelo  @relation(fields: [modeloId], references: [id])

  @@unique([empresaId, placa])
  @@index([empresaId])
  @@index([clienteId])
  @@index([placa])
  @@map("Vehiculo")
}

model Cliente {
  id        String   @id @default(uuid()) @map("id")
  empresaId String   @map("empresa_id")
  nombre    String   @map("nombre")
  rfc       String?  @map("rfc")
  email     String?  @map("email")
  telefono  String?  @map("telefono")
  direccion String?  @map("direccion")
  estado    String   @default("ACTIVO") @map("estado")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  vehiculos Vehiculo[]

  @@unique([empresaId, rfc])
  @@unique([empresaId, email])
  @@index([empresaId])
  @@index([nombre])
  @@map("Cliente")
}

model SatPais {
  id     String @id @default(uuid()) @map("id")
  codigo String @unique @map("codigo")
  nombre String @map("nombre")

  estados SatEstado[]

  @@index([nombre])
  @@map("SatPais")
}

model SatEstado {
  id     String @id @default(uuid()) @map("id")
  codigo String @map("codigo")
  nombre String @map("nombre")
  paisId String @map("pais_id")

  pais            SatPais           @relation(fields: [paisId], references: [id])
  municipios      SatMunicipio[]
  codigosPostales SatCodigoPostal[]

  @@index([paisId])
  @@index([nombre])
  @@map("SatEstado")
}

model SatMunicipio {
  id       String @id @default(uuid()) @map("id")
  codigo   String @map("codigo")
  nombre   String @map("nombre")
  estadoId String @map("estado_id")

  estado          SatEstado         @relation(fields: [estadoId], references: [id])
  codigosPostales SatCodigoPostal[]

  @@index([estadoId])
  @@index([nombre])
  @@map("SatMunicipio")
}

model SatCodigoPostal {
  id          String  @id @default(uuid()) @map("id")
  codigo      String  @map("codigo")
  estadoId    String  @map("estado_id")
  municipioId String? @map("municipio_id")

  estado    SatEstado     @relation(fields: [estadoId], references: [id])
  municipio SatMunicipio? @relation(fields: [municipioId], references: [id])
  colonias  SatColonia[]

  @@index([codigo])
  @@index([estadoId])
  @@index([municipioId])
  @@map("SatCodigoPostal")
}

model SatColonia {
  id             String @id @default(uuid()) @map("id")
  codigo         String @map("codigo")
  nombre         String @map("nombre")
  codigoPostalId String @map("codigo_postal_id")

  codigoPostal SatCodigoPostal @relation(fields: [codigoPostalId], references: [id])

  @@index([codigoPostalId])
  @@index([nombre])
  @@map("SatColonia")
}

model SatProductoServicio {
  id          String  @id @default(uuid()) @map("id")
  codigo      String  @unique @map("codigo")
  descripcion String  @map("descripcion")
  nivel       String? @map("nivel")
  incluyeIva  Boolean @default(false) @map("incluye_iva")
  incluyeIeps Boolean @default(false) @map("incluye_ieps")

  @@index([codigo])
  @@index([descripcion])
  @@map("SatProductoServicio")
}

model SatUnidadMedida {
  id      String  @id @default(uuid()) @map("id")
  codigo  String  @unique @map("codigo")
  nombre  String  @map("nombre")
  simbolo String? @map("simbolo")

  @@index([nombre])
  @@map("SatUnidadMedida")
}

model SatRegimenFiscal {
  id     String @id @default(uuid()) @map("id")
  codigo String @unique @map("codigo")
  nombre String @map("nombre")
  tipo   String @map("tipo")

  @@index([nombre])
  @@index([tipo])
  @@map("SatRegimenFiscal")
}

model SatUsoCfdi {
  id     String @id @default(uuid()) @map("id")
  codigo String @unique @map("codigo")
  nombre String @map("nombre")
  tipo   String @map("tipo")

  @@index([nombre])
  @@index([tipo])
  @@map("SatUsoCfdi")
}
