generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDIENTE
  ACTIVO
  INACTIVO
  BLOQUEADO
}

model Usuario {
  id           String     @id @default(uuid()) @map("id")
  email        String     @unique @map("email")
  passwordHash String?    @map("password_hash")
  nombre       String?    @map("nombre")
  estado       UserStatus @default(PENDIENTE) @map("estado")

  intentosFallidos Int       @default(0) @map("intentos_fallidos")
  bloqueadoHasta   DateTime? @map("bloqueado_hasta")

  companyId String? @map("company_id")
  branchId  String? @map("branch_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  verificaciones      VerificacionCuenta[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  proveedoresSociales ProveedorSocial[]
  empresa             Empresa?             @relation(fields: [companyId], references: [id])
  roles               UsuarioRol[]
  empresasAsignadas   UsuarioEmpresa[]
  sucursalesAsignadas UsuarioSucursal[]
  diagnosticos        Diagnostico[]
  tiemposTecnico      TiempoTecnico[]
  cajasApertura       Caja[]    @relation("CajaApertura")
  cajasCierre         Caja[]    @relation("CajaCierre")
  notificaciones      NotificacionTaller[]

  @@map("Usuario")
}

model VerificacionCuenta {
  id        String   @id @default(uuid()) @map("id")
  usuarioId String   @map("usuario_id")
  token     String   @unique @map("token")
  expiraEn  DateTime @map("expira_en")
  usado     Boolean  @default(false) @map("usado")

  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("VerificacionCuenta")
}

model RefreshToken {
  id        String   @id @default(uuid()) @map("id")
  usuarioId String   @map("usuario_id")
  token     String   @unique @map("token")
  expiraEn  DateTime @map("expira_en")
  usado     Boolean  @default(false) @map("usado")
  revocado  Boolean  @default(false) @map("revocado")

  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("RefreshToken")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @map("id")
  usuarioId String   @map("usuario_id")
  token     String   @unique @map("token")
  expiraEn  DateTime @map("expira_en")
  usado     Boolean  @default(false) @map("usado")

  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("PasswordResetToken")
}

model ProveedorSocial {
  id         String @id @default(uuid()) @map("id")
  usuarioId  String @map("usuario_id")
  provider   String @map("provider")
  providerId String @map("provider_id")

  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@map("ProveedorSocial")
}

model Rol {
  id          String  @id @default(uuid()) @map("id")
  nombre      String  @unique @map("nombre")
  descripcion String? @map("descripcion")
  esGlobal    Boolean @default(true) @map("es_global")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  usuarios UsuarioRol[]
  permisos RolPermiso[]

  @@map("Rol")
}

model Permiso {
  id          String  @id @default(uuid()) @map("id")
  nombre      String  @unique @map("nombre")
  descripcion String? @map("descripcion")
  modulo      String  @map("modulo")
  accion      String  @map("accion")

  createdAt DateTime @default(now()) @map("created_at")

  roles RolPermiso[]

  @@map("Permiso")
}

model RolPermiso {
  rolId     String @map("rol_id")
  permisoId String @map("permiso_id")

  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)
  permiso Permiso @relation(fields: [permisoId], references: [id], onDelete: Cascade)

  @@id([rolId, permisoId])
  @@map("RolPermiso")
}

model UsuarioRol {
  id        String  @id @default(uuid()) @map("id")
  usuarioId String  @map("usuario_id")
  rolId     String  @map("rol_id")
  companyId String? @map("company_id")

  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  rol     Rol     @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, rolId, companyId])
  @@map("UsuarioRol")
}

enum EmpresaStatus {
  ACTIVA
  SUSPENDIDA
  INACTIVA
}

model Empresa {
  id                 String        @id @default(uuid()) @map("id")
  nombre             String        @map("nombre")
  rfc                String        @unique @map("rfc")
  razonSocial        String        @map("razon_social")
  codigoPostalFiscal String        @map("codigo_postal_fiscal")
  regimenFiscal      String        @map("regimen_fiscal")
  logoUrl            String?       @map("logo_url")
  colorPrimario      String?       @map("color_primario")
  colorSecundario    String?       @map("color_secundario")
  tema               String?       @default("light") @map("tema")
  estado             EmpresaStatus @default(ACTIVA) @map("estado")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  usuarios        Usuario[]
  sucursales      Sucursal[]
  usuariosAsignados UsuarioEmpresa[]
  clientes        Cliente[]
  vehiculos       Vehiculo[]
  citas           Cita[]
  recepciones     RecepcionVehiculo[]
  ordenesTrabajo  OrdenTrabajo[]
  cotizaciones    Cotizacion[]
  proveedores     Proveedor[]
  ordenesCompra   OrdenCompra[]
  refacciones     Refaccion[]
  inventarios     Inventario[]
  movimientosInv  MovimientoInventario[]
  cajas           Caja[]
  pagos           Pago[]
  notificaciones  NotificacionTaller[]
  certificadosFiscales CertificadoFiscal[]

  @@map("Empresa")
}

model Sucursal {
  id        String  @id @default(uuid()) @map("id")
  empresaId String  @map("empresa_id")
  nombre    String  @map("nombre")
  direccion String? @map("direccion")
  telefono  String? @map("telefono")
  esMatriz  Boolean @default(false) @map("es_matriz")
  latitud   Float?  @map("latitud")
  longitud  Float?  @map("longitud")
  estado    String  @default("ACTIVA") @map("estado")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  empresa           Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  usuariosAsignados UsuarioSucursal[]
  citas             Cita[]
  recepciones       RecepcionVehiculo[]
  ordenesTrabajo    OrdenTrabajo[]
  inventarios       Inventario[]
  movimientosInv    MovimientoInventario[]
  cajas             Caja[]
  pagos             Pago[]
  notificaciones    NotificacionTaller[]

  @@map("Sucursal")
}

model UsuarioEmpresa {
  id        String  @id @default(uuid()) @map("id")
  usuarioId String  @map("usuario_id")
  empresaId String  @map("empresa_id")
  activa    Boolean @default(false) @map("activa")

  createdAt DateTime @default(now()) @map("created_at")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, empresaId])
  @@map("UsuarioEmpresa")
}

model UsuarioSucursal {
  id         String  @id @default(uuid()) @map("id")
  usuarioId  String  @map("usuario_id")
  sucursalId String  @map("sucursal_id")
  activa     Boolean @default(false) @map("activa")

  createdAt DateTime @default(now()) @map("created_at")

  usuario  Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sucursal Sucursal @relation(fields: [sucursalId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, sucursalId])
  @@map("UsuarioSucursal")
}

model Auditoria {
  id        String  @id @default(uuid()) @map("id")
  usuarioId String? @map("usuario_id")
  accion    String  @map("accion")
  entidad   String  @map("entidad")
  entidadId String? @map("entidad_id")
  payload   Json?   @map("payload")
  contexto  String? @map("contexto")
  ip        String? @map("ip")

  createdAt DateTime @default(now()) @map("created_at")

  @@map("Auditoria")
}

model Marca {
  id        String   @id @default(uuid()) @map("id")
  nombre    String   @unique @map("nombre")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  modelos  Modelo[]
  vehiculos Vehiculo[]

  @@map("Marca")
}

model Modelo {
  id      String @id @default(uuid()) @map("id")
  marcaId String @map("marca_id")
  nombre  String @map("nombre")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String? @map("created_by")

  marca   Marca     @relation(fields: [marcaId], references: [id], onDelete: Cascade)
  vehiculos Vehiculo[]

  @@unique([marcaId, nombre])
  @@map("Modelo")
}

model Vehiculo {
  id         String   @id @default(uuid()) @map("id")
  empresaId  String   @map("empresa_id")
  clienteId  String   @map("cliente_id")
  marcaId    String   @map("marca_id")
  modeloId   String   @map("modelo_id")
  placa      String   @map("placa")
  numeroSerie String? @map("numero_serie")
  anio       Int?     @map("anio")
  color      String?  @map("color")
  estado     String   @default("ACTIVO") @map("estado")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  cliente Cliente @relation(fields: [clienteId], references: [id])
  marca   Marca   @relation(fields: [marcaId], references: [id])
  modelo  Modelo  @relation(fields: [modeloId], references: [id])
  citas   Cita[]
  recepciones RecepcionVehiculo[]
  ordenesTrabajo OrdenTrabajo[]

  @@unique([empresaId, placa])
  @@index([empresaId])
  @@index([clienteId])
  @@index([placa])
  @@map("Vehiculo")
}

model Cliente {
  id        String   @id @default(uuid()) @map("id")
  empresaId String   @map("empresa_id")
  nombre    String   @map("nombre")
  rfc       String?  @map("rfc")
  email     String?  @map("email")
  telefono  String?  @map("telefono")
  direccion String?  @map("direccion")
  estado    String   @default("ACTIVO") @map("estado")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  vehiculos Vehiculo[]
  citas Cita[]
  ordenesTrabajo OrdenTrabajo[]
  recepciones RecepcionVehiculo[]

  @@unique([empresaId, rfc])
  @@unique([empresaId, email])
  @@index([empresaId])
  @@index([nombre])
  @@map("Cliente")
}

model SatPais {
  id     String @id @default(uuid()) @map("id")
  codigo String @unique @map("codigo")
  nombre String @map("nombre")

  estados SatEstado[]

  @@index([nombre])
  @@map("SatPais")
}

model SatEstado {
  id     String @id @default(uuid()) @map("id")
  codigo String @map("codigo")
  nombre String @map("nombre")
  paisId String @map("pais_id")

  pais            SatPais           @relation(fields: [paisId], references: [id])
  municipios      SatMunicipio[]
  codigosPostales SatCodigoPostal[]

  @@index([paisId])
  @@index([nombre])
  @@map("SatEstado")
}

model SatMunicipio {
  id       String @id @default(uuid()) @map("id")
  codigo   String @map("codigo")
  nombre   String @map("nombre")
  estadoId String @map("estado_id")

  estado          SatEstado         @relation(fields: [estadoId], references: [id])
  codigosPostales SatCodigoPostal[]

  @@index([estadoId])
  @@index([nombre])
  @@map("SatMunicipio")
}

model SatCodigoPostal {
  id          String  @id @default(uuid()) @map("id")
  codigo      String  @map("codigo")
  estadoId    String  @map("estado_id")
  municipioId String? @map("municipio_id")

  estado    SatEstado     @relation(fields: [estadoId], references: [id])
  municipio SatMunicipio? @relation(fields: [municipioId], references: [id])
  colonias  SatColonia[]

  @@index([codigo])
  @@index([estadoId])
  @@index([municipioId])
  @@map("SatCodigoPostal")
}

model SatColonia {
  id             String @id @default(uuid()) @map("id")
  codigo         String @map("codigo")
  nombre         String @map("nombre")
  codigoPostalId String @map("codigo_postal_id")

  codigoPostal SatCodigoPostal @relation(fields: [codigoPostalId], references: [id])

  @@index([codigoPostalId])
  @@index([nombre])
  @@map("SatColonia")
}

model SatProductoServicio {
  id          String  @id @default(uuid()) @map("id")
  codigo      String  @unique @map("codigo")
  descripcion String  @map("descripcion")
  nivel       String? @map("nivel")
  incluyeIva  Boolean @default(false) @map("incluye_iva")
  incluyeIeps Boolean @default(false) @map("incluye_ieps")

  @@index([codigo])
  @@index([descripcion])
  @@map("SatProductoServicio")
}

model SatUnidadMedida {
  id      String  @id @default(uuid()) @map("id")
  codigo  String  @unique @map("codigo")
  nombre  String  @map("nombre")
  simbolo String? @map("simbolo")

  @@index([nombre])
  @@map("SatUnidadMedida")
}

model SatRegimenFiscal {
  id     String @id @default(uuid()) @map("id")
  codigo String @unique @map("codigo")
  nombre String @map("nombre")
  tipo   String @map("tipo")

  @@index([nombre])
  @@index([tipo])
  @@map("SatRegimenFiscal")
}

model SatUsoCfdi {
  id     String @id @default(uuid()) @map("id")
  codigo String @unique @map("codigo")
  nombre String @map("nombre")
  tipo   String @map("tipo")

  @@index([nombre])
  @@index([tipo])
  @@map("SatUsoCfdi")
}

model Cita {
  id         String   @id @default(uuid()) @map("id")
  empresaId  String   @map("empresa_id")
  sucursalId String?  @map("sucursal_id")
  clienteId  String   @map("cliente_id")
  vehiculoId String   @map("vehiculo_id")
  fecha      DateTime @map("fecha")
  hora       String   @map("hora") // HH:mm
  estado     String   @default("PROGRAMADA") @map("estado") // PROGRAMADA, CONFIRMADA, CANCELADA, COMPLETADA
  notas      String?  @map("notas")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  empresa  Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  sucursal Sucursal? @relation(fields: [sucursalId], references: [id])
  cliente  Cliente   @relation(fields: [clienteId], references: [id])
  vehiculo Vehiculo  @relation(fields: [vehiculoId], references: [id])
  recepcionVehiculo RecepcionVehiculo? @relation("CitaRecepcion")

  @@index([empresaId])
  @@index([sucursalId])
  @@index([clienteId])
  @@index([vehiculoId])
  @@index([fecha])
  @@map("Cita")
}

model RecepcionVehiculo {
  id               String   @id @default(uuid()) @map("id")
  empresaId        String   @map("empresa_id")
  sucursalId       String?  @map("sucursal_id")
  citaId           String?  @unique @map("cita_id")
  clienteId        String   @map("cliente_id")
  vehiculoId       String   @map("vehiculo_id")
  kilometraje      Int      @map("kilometraje")
  nivelCombustible String   @map("nivel_combustible") // 1/4, 1/2, 3/4, LLENO
  componentesFaltantes String? @map("componentes_faltantes") // JSON string
  daniosCarroceria String?  @map("danios_carroceria")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  empresa  Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  sucursal Sucursal? @relation(fields: [sucursalId], references: [id])
  cita     Cita?     @relation("CitaRecepcion", fields: [citaId], references: [id])
  cliente  Cliente   @relation(fields: [clienteId], references: [id])
  vehiculo Vehiculo  @relation(fields: [vehiculoId], references: [id])
  ordenes  OrdenTrabajo[] @relation("OrdenRecepcion")

  fotos RecepcionFoto[]

  @@index([empresaId])
  @@index([sucursalId])
  @@index([clienteId])
  @@index([vehiculoId])
  @@index([createdAt])
  @@map("RecepcionVehiculo")
}

model RecepcionFoto {
  id          String @id @default(uuid()) @map("id")
  recepcionId String @map("recepcion_id")
  url         String @map("url")
  orden       Int    @default(0) @map("orden")

  recepcion RecepcionVehiculo @relation(fields: [recepcionId], references: [id], onDelete: Cascade)

  @@index([recepcionId])
  @@map("RecepcionFoto")
}

model OrdenTrabajo {
  id              String   @id @default(uuid()) @map("id")
  empresaId       String   @map("empresa_id")
  sucursalId      String?  @map("sucursal_id")
  clienteId       String   @map("cliente_id")
  vehiculoId      String   @map("vehiculo_id")
  recepcionId     String?  @map("recepcion_id")
  folio           String   @map("folio") // Folio único por empresa
  estado          String   @default("RECIBIDO") @map("estado") // RECIBIDO, DIAGNOSTICO, PRESUPUESTADO, APROBADO, TRABAJANDO, TERMINADO, FACTURADO, ENTREGADO, CANCELADO
  descripcion     String?  @map("descripcion")
  diagnostico     String?  @map("diagnostico")
  totalEstimado   Decimal? @map("total_estimado")
  totalReal       Decimal? @map("total_real")
  fechaInicio     DateTime? @map("fecha_inicio")
  fechaFin        DateTime? @map("fecha_fin")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  empresa           Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  sucursal          Sucursal?         @relation(fields: [sucursalId], references: [id])
  cliente           Cliente           @relation(fields: [clienteId], references: [id])
  vehiculo          Vehiculo          @relation(fields: [vehiculoId], references: [id])
  recepcion         RecepcionVehiculo? @relation("OrdenRecepcion", fields: [recepcionId], references: [id])
  diagnosticos      Diagnostico[]
  tiemposTecnico    TiempoTecnico[]
  cotizaciones      Cotizacion[]
  pagos             Pago[]

  @@unique([empresaId, folio])
  @@index([empresaId])
  @@index([sucursalId])
  @@index([clienteId])
  @@index([vehiculoId])
  @@index([recepcionId])
  @@index([estado])
  @@map("OrdenTrabajo")
}

model Diagnostico {
  id                String   @id @default(uuid()) @map("id")
  ordenTrabajoId    String   @map("orden_trabajo_id")
  tecnicoId         String   @map("tecnico_id")
  sintomas          String?  @map("sintomas")
  fallasEncontradas String?  @map("fallas_encontradas")
  desgastesPiezas   String?  @map("desgastes_piezas")
  conclusion        String?  @map("conclusion")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  ordenTrabajo OrdenTrabajo @relation(fields: [ordenTrabajoId], references: [id])
  tecnico      Usuario      @relation(fields: [tecnicoId], references: [id])

  @@index([ordenTrabajoId])
  @@index([tecnicoId])
  @@index([createdAt])
  @@map("Diagnostico")
}

model TiempoTecnico {
  id             String    @id @default(uuid()) @map("id")
  ordenTrabajoId String    @map("orden_trabajo_id")
  tecnicoId      String    @map("tecnico_id")
  horaInicio     DateTime  @map("hora_inicio")
  horaFin        DateTime? @map("hora_fin")
  estado         String    @default("ACTIVO") @map("estado") // ACTIVO, PAUSADO, COMPLETADO

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")

  ordenTrabajo OrdenTrabajo @relation(fields: [ordenTrabajoId], references: [id])
  tecnico      Usuario      @relation(fields: [tecnicoId], references: [id])

  @@index([ordenTrabajoId])
  @@index([tecnicoId])
  @@index([estado])
  @@map("TiempoTecnico")
}

model Cotizacion {
  id             String   @id @default(uuid()) @map("id")
  empresaId      String   @map("empresa_id")
  ordenTrabajoId String   @map("orden_trabajo_id")
  folio          String   @map("folio")
  estado         String   @default("BORRADOR") @map("estado") // BORRADOR, ENVIADA, APROBADA, RECHAZADA
  subtotal       Decimal  @default(0) @map("subtotal")
  descuento      Decimal  @default(0) @map("descuento")
  iva            Decimal  @default(0) @map("iva")
  total          Decimal  @default(0) @map("total")
  notas          String?  @map("notas")
  fechaValidez   DateTime? @map("fecha_validez")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  empresa      Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  ordenTrabajo OrdenTrabajo      @relation(fields: [ordenTrabajoId], references: [id])
  detalles     CotizacionDetalle[]

  @@unique([empresaId, folio])
  @@index([empresaId])
  @@index([ordenTrabajoId])
  @@index([estado])
  @@map("Cotizacion")
}

model CotizacionDetalle {
  id             String  @id @default(uuid()) @map("id")
  cotizacionId   String  @map("cotizacion_id")
  tipo           String  @map("tipo") // SERVICIO, MANO_OBRA, REFACCION
  descripcion    String  @map("descripcion")
  cantidad       Int     @default(1) @map("cantidad")
  precioUnitario Decimal @map("precio_unitario")
  descuento      Decimal @default(0) @map("descuento")
  subtotal       Decimal @default(0) @map("subtotal")
  iva            Decimal @default(0) @map("iva")
  total          Decimal @default(0) @map("total")

  cotizacion Cotizacion @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  @@index([cotizacionId])
  @@map("CotizacionDetalle")
}

model Proveedor {
  id        String   @id @default(uuid()) @map("id")
  empresaId String   @map("empresa_id")
  nombre    String   @map("nombre")
  rfc       String?  @map("rfc")
  email     String?  @map("email")
  telefono  String?  @map("telefono")
  direccion String?  @map("direccion")
  contacto  String?  @map("contacto")
  estado    String   @default("ACTIVO") @map("estado")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  ordenesCompra OrdenCompra[]

  @@unique([empresaId, rfc])
  @@index([empresaId])
  @@index([nombre])
  @@map("Proveedor")
}

model OrdenCompra {
  id          String   @id @default(uuid()) @map("id")
  empresaId   String   @map("empresa_id")
  proveedorId String   @map("proveedor_id")
  folio       String   @map("folio")
  estado      String   @default("BORRADOR") @map("estado") // BORRADOR, ENVIADA, RECIBIDA, CANCELADA
  descripcion String?  @map("descripcion")
  subtotal    Decimal  @default(0) @map("subtotal")
  descuento   Decimal  @default(0) @map("descuento")
  iva         Decimal  @default(0) @map("iva")
  total       Decimal  @default(0) @map("total")
  fechaPedido DateTime? @map("fecha_pedido")
  fechaRecibido DateTime? @map("fecha_recibido")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  empresa  Empresa             @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  proveedor Proveedor          @relation(fields: [proveedorId], references: [id])
  detalles OrdenCompraDetalle[]

  @@unique([empresaId, folio])
  @@index([empresaId])
  @@index([proveedorId])
  @@index([estado])
  @@map("OrdenCompra")
}

model OrdenCompraDetalle {
  id            String  @id @default(uuid()) @map("id")
  ordenCompraId String  @map("orden_compra_id")
  descripcion   String  @map("descripcion")
  cantidad      Int     @default(1) @map("cantidad")
  precioUnitario Decimal @map("precio_unitario")
  descuento     Decimal @default(0) @map("descuento")
  subtotal      Decimal @default(0) @map("subtotal")
  iva           Decimal @default(0) @map("iva")
  total         Decimal @default(0) @map("total")

  ordenCompra OrdenCompra @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)

  @@index([ordenCompraId])
  @@map("OrdenCompraDetalle")
}

model Refaccion {
  id          String   @id @default(uuid()) @map("id")
  empresaId   String   @map("empresa_id")
  codigo      String   @map("codigo")
  nombre      String   @map("nombre")
  descripcion String?  @map("descripcion")
  precio      Decimal  @default(0) @map("precio")
  costo       Decimal  @default(0) @map("costo")
  unidad      String   @default("PIEZA") @map("unidad")
  estado      String   @default("ACTIVO") @map("estado")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdBy String?  @map("created_by")
  updatedBy String?  @map("updated_by")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  inventarios Inventario[]
  movimientosInv MovimientoInventario[]

  @@unique([empresaId, codigo])
  @@index([empresaId])
  @@index([nombre])
  @@map("Refaccion")
}

model Inventario {
  id           String  @id @default(uuid()) @map("id")
  empresaId    String  @map("empresa_id")
  sucursalId   String  @map("sucursal_id")
  refaccionId  String  @map("refaccion_id")
  stockActual  Int     @default(0) @map("stock_actual")
  stockMinimo  Int     @default(0) @map("stock_minimo")
  precioPromedio Decimal @default(0) @map("precio_promedio")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  empresa   Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  sucursal  Sucursal  @relation(fields: [sucursalId], references: [id])
  refaccion Refaccion @relation(fields: [refaccionId], references: [id])

  @@unique([empresaId, sucursalId, refaccionId])
  @@index([empresaId])
  @@index([sucursalId])
  @@index([refaccionId])
  @@map("Inventario")
}

enum TipoMovimiento {
  ENTRADA_POR_COMPRA
  SALIDA_POR_ORDEN
  AJUSTE_INVENTARIO
  TRANSFERENCIA
}

model MovimientoInventario {
  id              String          @id @default(uuid()) @map("id")
  empresaId       String          @map("empresa_id")
  sucursalId      String          @map("sucursal_id")
  refaccionId     String          @map("refaccion_id")
  tipo            String          @map("tipo") // ENTRADA_POR_COMPRA, SALIDA_POR_ORDEN, AJUSTE_INVENTARIO, TRANSFERENCIA
  cantidad        Int             @map("cantidad")
  stockAnterior   Int             @map("stock_anterior")
  stockNuevo      Int             @map("stock_nuevo")
  referencia      String?         @map("referencia") // ej. OrdenCompraID, OrdenTrabajoID
  observaciones   String?         @map("observaciones")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  empresa   Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  sucursal  Sucursal  @relation(fields: [sucursalId], references: [id])
  refaccion Refaccion @relation(fields: [refaccionId], references: [id])

  @@index([empresaId])
  @@index([sucursalId])
  @@index([refaccionId])
  @@index([tipo])
  @@index([createdAt])
  @@map("MovimientoInventario")
}

model Caja {
  id               String    @id @default(uuid()) @map("id")
  empresaId        String    @map("empresa_id")
  sucursalId       String    @map("sucursal_id")
  estado           String    @default("ABIERTA") @map("estado") // ABIERTA, CERRADA
  saldoInicial     Decimal   @default(0) @map("saldo_inicial")
  saldoActual      Decimal   @default(0) @map("saldo_actual")
  conteoFisico     Decimal?  @map("conteo_fisico")
  diferencia       Decimal?  @map("diferencia")
  fechaApertura    DateTime  @default(now()) @map("fecha_apertura")
  fechaCierre      DateTime? @map("fecha_cierre")
  observaciones    String?   @map("observaciones")
  operadorAperturaId String  @map("operador_apertura_id")
  operadorCierreId String?   @map("operador_cierre_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  empresa   Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  sucursal  Sucursal  @relation(fields: [sucursalId], references: [id], onDelete: Cascade)
  operadorApertura Usuario @relation("CajaApertura", fields: [operadorAperturaId], references: [id])
  operadorCierre   Usuario? @relation("CajaCierre", fields: [operadorCierreId], references: [id])
  movimientos MovimientoCaja[]
  pagos       Pago[]

  @@index([empresaId])
  @@index([sucursalId])
  @@index([estado])
  @@map("Caja")
}

model MovimientoCaja {
  id        String   @id @default(uuid()) @map("id")
  cajaId    String   @map("caja_id")
  tipo      String   @map("tipo") // APERTURA, PAGO, RETIRO, INGRESO, CIERRE
  monto     Decimal  @map("monto")
  saldoAnterior Decimal @default(0) @map("saldo_anterior")
  saldoNuevo    Decimal @default(0) @map("saldo_nuevo")
  referencia String?  @map("referencia") // OrdenTrabajoID, PagoID
  observaciones String? @map("observaciones")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  caja Caja @relation(fields: [cajaId], references: [id], onDelete: Cascade)

  @@index([cajaId])
  @@index([tipo])
  @@index([createdAt])
  @@map("MovimientoCaja")
}

model Pago {
  id             String   @id @default(uuid()) @map("id")
  empresaId      String   @map("empresa_id")
  sucursalId     String?  @map("sucursal_id")
  cajaId         String?  @map("caja_id")
  ordenTrabajoId String   @map("orden_trabajo_id")
  monto          Decimal  @map("monto")
  metodoPago     String   @default("EFECTIVO") @map("metodo_pago") // EFECTIVO, TARJETA, TRANSFERENCIA
  referencia     String?  @map("referencia")
  esParcial      Boolean  @default(false) @map("es_parcial")

  createdAt DateTime @default(now()) @map("created_at")
  createdBy String?  @map("created_by")

  empresa      Empresa      @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  sucursal     Sucursal?    @relation(fields: [sucursalId], references: [id])
  caja         Caja?        @relation(fields: [cajaId], references: [id])
  ordenTrabajo OrdenTrabajo @relation(fields: [ordenTrabajoId], references: [id])

  @@index([empresaId])
  @@index([sucursalId])
  @@index([cajaId])
  @@index([ordenTrabajoId])
  @@index([createdAt])
  @@map("Pago")
}

model NotificacionTaller {
  id              String   @id @default(uuid()) @map("id")
  empresaId       String   @map("empresa_id")
  sucursalId      String?  @map("sucursal_id")
  usuarioId       String?  @map("usuario_id")
  tipo            String   @map("tipo") // ORDEN_TERMINADA, COTIZACION_APROBACION, PAGO_REGISTRADO, SISTEMA
  titulo          String   @map("titulo")
  mensaje         String   @map("mensaje")
  referencia      String?  @map("referencia") // OrdenTrabajoID, CotizacionID, etc.
  leida           Boolean  @default(false) @map("leida")
  fechaLectura    DateTime? @map("fecha_lectura")
  prioridad       String   @default("NORMAL") @map("prioridad") // BAJA, NORMAL, ALTA, URGENTE

  createdAt DateTime @default(now()) @map("created_at")

  empresa  Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  sucursal Sucursal? @relation(fields: [sucursalId], references: [id])
  usuario  Usuario?  @relation(fields: [usuarioId], references: [id])

  @@index([empresaId])
  @@index([sucursalId])
  @@index([usuarioId])
  @@index([leida])
  @@index([createdAt])
  @@map("NotificacionTaller")
}

model CertificadoFiscal {
  id             String   @id @default(uuid()) @map("id")
  empresaId      String   @unique @map("empresa_id")
  rfc            String   @map("rfc")
  certificadoCer String   @map("certificado_cer") // contenido base64 del .cer
  llaveKey       String   @map("llave_key") // contenido cifrado AES-256 del .key
  passwordHash   String   @map("password_hash") // contraseña cifrada AES-256
  vigenciaDesde  DateTime @map("vigencia_desde")
  vigenciaHasta  DateTime @map("vigencia_hasta")
  activo         Boolean  @default(true) @map("activo")
  emisorRazonSocial String? @map("emisor_razon_social")
  serie          String?  @map("serie")
  numeroCertificado String? @map("numero_certificado")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  updatedBy String?  @map("updated_by")

  empresa Empresa @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@map("CertificadoFiscal")
}
